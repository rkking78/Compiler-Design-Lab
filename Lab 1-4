Bison part

/* Definition Section */ 
%{ 
#include <stdio.h> 
#include <string.h> 
int yylex(void); 
int yyerror(const char *s); 
extern FILE *yyin; 
%} 
%union { 
float frac;  
} 
/* Token */ 
%token EOL 
%token <frac> FRACTION 
%token PLUS 
%type <frac> exp2 
%token MINUS 
%token MULTIPLY 
%left PLUS MINUS 
%left MULTIPLY 
%left DIVISION 
%token LEFTPAREN 
%token RIGHTPAREN 
%type <frac> fact2  
%% 
input: 

|input line 
; 
line: 
     exp2 EOL {printf ("%f \n", $1);} 
|   exp2 {printf("%f \n", $1);} 
|   EOL {} 
; 
 
exp2: 
       exp2 PLUS exp2 { $$ = $1 + $3; } 
|   exp2 MINUS exp2 { $$ = $1 - $3; } 
|   exp2 MULTIPLY exp2 { $$ = $1 * $3; } 
|   exp2 DIVISION exp2 { $$ = $1 / $3; } 
|   fact2 
; 

fact2: 
    FRACTION { $$ = $1; } 
|   LEFTPAREN exp2 RIGHTPAREN {$$ = $2;}  
; 
%% 
/* User Section */ 
int main(void) { 
    yyin = fopen("lab1.txt", "r"); 
    int res=yyparse(); 
    fclose(yyin); 
    return res; 
} 
 
int yyerror(const char *s) { 
    printf("ERROR: %s \n", s); 
    return 0; 
}




