#include <stdio.h>
#include <string.h>

int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;
    while (t--) {
        char s[105];
        scanf("%s", s);
        int n = strlen(s);
        int has_pair = 0;
        for (int i = 0; i + 1 < n; ++i) {
            if (s[i] == s[i+1]) { has_pair = 1; break; }
        }
        if (has_pair) printf("1\n");
        else printf("%d\n", n);
    }
    return 0;
}
